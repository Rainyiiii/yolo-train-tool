<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YOLOTeamTrainingPlatform</AssemblyName>
    <RootNamespace>YOLOTeamTrainingPlatform.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.2.7</Version>
    <Product>YOLO团队训练平台</Product>
    <Company>YOLO Team Training Platform Contributors</Company>
    <Description>Local-first YOLO dataset, training, model asset, export, and testing desktop platform.</Description>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
  </ItemGroup>
</Project>
